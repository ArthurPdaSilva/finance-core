# Backend example environment variables
# Copy to backend/.env and fill values before running the backend

# OpenAI API key used by the project's LLM integrations
OPENAI_API_KEY=

# PostgreSQL URL used by Docker Compose
DATABASE_URL=postgresql+psycopg://finance:finance@database:5432/finance
DATABASE_NAME=finance

# Allowed frontend origins, separated by commas
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# Self-hosted Langfuse (Docker Compose)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=http://langfuse-web:3000

# Simple API key used by the frontend to call the backend endpoints
# Keep this secret in production
API_KEY=your_api_key_here
